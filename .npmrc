auto-install-peers = true

# pnpm 10 refuses to run dependency install scripts unless they are listed here.
# These five need theirs: prisma/@prisma/engines fetch the query-engine binary,
# esbuild and sharp fetch their platform native binaries, msgpackr-extract its
# optional accelerator. Without this the install "succeeds" and the failure
# surfaces much later as a missing engine or binary at generate/build time.
only-built-dependencies[]=@prisma/engines
only-built-dependencies[]=prisma
only-built-dependencies[]=esbuild
only-built-dependencies[]=sharp
only-built-dependencies[]=msgpackr-extract

# Network resilience for slow / lossy links.
#
# Docker builds on a constrained connection were failing with ECONNRESET part
# way through the large native tarballs (@next/swc, sharp are ~34MB each): the
# defaults give up long before those finish at a few hundred KB/s. These raise
# the ceiling rather than change any resolution behaviour, so a fast connection
# is unaffected — nothing waits that it would not have waited anyway.
fetch-retries = 5
fetch-retry-mintimeout = 20000
fetch-retry-maxtimeout = 120000
fetch-timeout = 600000

# Fewer parallel sockets so the available bandwidth goes to a handful of
# downloads that complete, instead of 16 that all crawl and time out together.
network-concurrency = 4

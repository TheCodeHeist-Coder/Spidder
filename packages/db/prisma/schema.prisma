// Spidder data model. Postgres + Prisma.
// Ephemeral state (live snapshot, presence, rate limits, judge queue) lives in
// Redis, NOT here. Postgres is the durable record of users, problems, battles,
// submissions, and results.

generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

/**
 * Review state of a problem.
 *
 * Defaults to APPROVED so problems created by an admin — and every problem
 * that existed before community submissions — are live without an extra step.
 * Only a player submission starts life as PENDING.
 *
 * REJECTED is not a dead end: the author edits and resubmits, which moves the
 * row back to PENDING. DRAFT is reserved for a future "save without
 * submitting" and is never selected for battle.
 */
enum ProblemStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum Mode {
  ONE_V_ONE
  TWO_V_TWO
  THREE_V_THREE
  FOUR_V_FOUR
}

enum Side {
  A
  B
}

enum BattleStatus {
  LOBBY
  COUNTDOWN
  IN_PROGRESS
  FINISHED
  ABANDONED
}

enum FinishReason {
  ALL_PASSED
  TIMEOUT
  FORFEIT
}

enum TestKind {
  SAMPLE
  HIDDEN
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  COMPLETED
  ERROR
}

/**
 * Authorisation role. Kept as an enum rather than a boolean so a MODERATOR
 * tier can be added later without another migration.
 */
enum Role {
  PLAYER
  SUPER_ADMIN
}

model User {
  id          String   @id @default(cuid())

  /**
   * Credentials. Nullable ONLY because a guest — someone who joined with a
   * room code and never registered — has none. A registered account always
   * has both; see auth.service signup/login.
   *
   * Email is stored lowercased so uniqueness is genuinely case-insensitive:
   * Postgres unique indexes are case-sensitive, so "A@x.com" and "a@x.com"
   * would otherwise both be insertable.
   */
  email        String? @unique
  passwordHash String?

  /**
   * True for a room-code guest. Guests can battle but get no dashboard,
   * rankings entry or public profile, and cannot log back in once their token
   * expires — there is no credential to log in WITH.
   */
  isGuest Boolean @default(false)

  /**
   * Authorisation role. PLAYER for everyone who signs up; SUPER_ADMIN only
   * ever set by the seed script or by hand in the database.
   *
   * Deliberately NOT settable through any API: there is no endpoint that
   * writes this column, so no request — however crafted — can escalate an
   * account to admin.
   */
  role Role @default(PLAYER)

  /**
   * Battle-facing identity. Unique, and stored lowercased in `usernameLower`
   * for the same case-folding reason as email, while `username` keeps the
   * casing the user typed so it displays the way they wrote it.
   */
  username      String
  usernameLower String @unique

  /** Real name. Optional; shown smaller beneath the username where present. */
  name String?

  createdAt   DateTime @default(now())

  // Cosmetic identity. Nullable because rows created before avatars existed
  // have none; readers fall back to a seeded default (see @repo/protocol
  // normalizeAvatar) rather than backfilling.
  avatarId    String?
  avatarColor String?

  /**
   * An uploaded profile photo, which overrides the pixel avatar when set.
   * The pixel avatar is kept rather than replaced: it is the fallback while
   * the image loads, and the user can clear the photo to go back to it.
   */
  imageUrl String?

  /**
   * Whether strangers may open this profile.
   *
   * Public by default: this is a competitive site where finding an opponent's
   * record and handles is the point, and a profile nobody can open is dead
   * weight. Everything on it is opt-in anyway — bio and links are blank until
   * the owner fills them in — and Settings can flip this to private.
   *
   * Guests are created with this false: they never chose anything, and they
   * have no Settings page on which to change their mind.
   */
  isPublic Boolean @default(true)

  /** Free-text "about me", shown on a public profile. */
  bio       String?
  /**
   * External profiles. Handles only, never URLs — the site builds the link
   * from the pattern in @repo/protocol PROFILE_LINKS, which is also the one
   * place a new site gets added.
   */
  github     String?
  linkedin   String?
  twitter    String?
  codeforces String?
  leetcode   String?
  codechef   String?
  hackerrank String?
  /** A personal site. Stored as a full URL, http(s) only. */
  website   String?

  // Progression. Awarded by ws-server when a battle finishes; see
  // packages/game/src/progression.ts for the (pure, tested) award rules.
  //
  // XP measures how MUCH you have fought and only ever rises. Skill is a
  // separate question, answered by the Glicko-2 fields below. Do not conflate
  // them: see the note at the top of packages/game/src/progression.ts.
  wins        Int      @default(0)
  losses      Int      @default(0)
  draws       Int      @default(0)
  xp          Int      @default(0)
  /** Consecutive wins. Reset to 0 on a loss; drives the streak multiplier. */
  winStreak   Int      @default(0)
  /** Highest winStreak ever reached, for display. */
  bestStreak  Int      @default(0)
  lastBattleAt DateTime?

  /**
   * Glicko-2 skill rating. Zero-sum and able to FALL, which is exactly what
   * makes it trustworthy where XP is not. See packages/game/src/rating.ts.
   *
   * `rating` is the familiar 1500-centred number. `ratingRd` is the deviation
   * (our uncertainty) and `ratingVolatility` the expected swing; both are part
   * of the algorithm rather than display values.
   *
   * The leaderboard sorts by rating - 2*ratingRd, not by `rating` alone, so a
   * small lucky sample cannot outrank a proven record.
   */
  rating           Float @default(1500)
  ratingRd         Float @default(350)
  ratingVolatility Float @default(0.06)
  /** Battles that actually moved the rating. Drives the provisional gate. */
  rankedBattles    Int   @default(0)
  /** Peak rating ever held, for display. Never decreases. */
  peakRating       Float @default(1500)

  /**
   * Counters that badges are evaluated against.
   *
   * Denormalised deliberately: recomputing "wins where the opponent was 200+
   * above" from the submission history on every profile view would be a join
   * across every battle a player ever fought. These are written once, in the
   * same transaction as the battle result.
   */
  upsetWins    Int @default(0)
  perfectWins  Int @default(0)
  /** Wins split by problem difficulty. Badges gate on these individually, so
      a pile of easy wins can never stand in for a hard one. */
  easyWins     Int @default(0)
  mediumWins   Int @default(0)
  hardWins     Int @default(0)
  /** How many distinct problems this user has won on. Incremented only on a
      first win for that problem, which the finish handler checks. */
  distinctProblemsWon Int @default(0)

  /**
   * How many problems this user authored that an admin approved.
   *
   * Denormalised rather than counted from `authoredProblems` on read: the
   * badge evaluator reads plain User columns (see BADGE_STAT_SELECT), and a
   * relation count would mean a join on every profile, leaderboard row and
   * battle finish. Incremented in the same transaction as the approval.
   */
  approvedProblems Int @default(0)

  /**
   * 1-based signup order, assigned at registration and never changed. The
   * Pioneer badge reads this; deriving it from createdAt would silently
   * re-rank everyone if a row were ever backdated or restored.
   */
  signupOrdinal Int @default(0)

  /**
   * Battles finished today and the day that counter refers to (UTC).
   *
   * Two columns rather than a COUNT over Battle: the anti-grind taper runs on
   * every finish, and a counter read is cheaper than an aggregate over the
   * player's whole history. `xpDay` lets the counter reset lazily on first use
   * of a new day instead of needing a scheduled job.
   */
  battlesToday Int    @default(0)
  xpDay        String @default("")

  hostedBattles Battle[]      @relation("HostedBattles")
  memberships   TeamMember[]
  submissions   Submission[]
  badges        UserBadge[]
  authoredProblems Problem[]   @relation("AuthoredProblems")
  ratingHistory RatingHistory[]
  seasonStandings SeasonStanding[]
  queueEntry    MatchQueueEntry?

  // Leagues. `hostedLeagues` are the ones this user runs; `leagueMemberships`
  // are the teams they play in. A user can do both, in different leagues.
  hostedLeagues     League[]         @relation("HostedLeagues")
  leagueMemberships LeagueTeamMember[]
  notifications     Notification[]

  // The ladder's sort key. Postgres cannot index an expression through
  // Prisma, so the leaderboard filters on these and sorts in the query.
  @@index([rating])
  @@index([rankedBattles])
}

/**
 * A badge a user has earned.
 *
 * Persisted rather than derived on read, for two reasons. First, `earnedAt` is
 * real history and cannot be recovered from current stats. Second, an award is
 * PERMANENT: if a threshold is later retuned, or a badge is retired from the
 * table entirely, everyone who earned it keeps it. Definitions live in
 * packages/game/src/badges.ts; this table only records who holds what.
 */
model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** Matches a `key` in packages/game BADGES. Not an enum: adding a badge
      should not require a migration. */
  badgeKey String
  earnedAt DateTime @default(now())
  /** The battle that triggered it, when there was one. */
  battleId String?

  /**
   * How many times a REPEATABLE badge has been earned, rendered as the "x2"
   * bubble on the medal. Always 1 for an ordinary badge.
   *
   * A column rather than extra rows: [userId, badgeKey] is unique, and that
   * uniqueness is what makes an award idempotent. A repeat increments.
   */
  count    Int      @default(1)

  @@unique([userId, badgeKey])
  @@index([userId])
  @@index([badgeKey])
}

/**
 * An admin-editable badge definition.
 *
 * Badges started as a hard-coded table in packages/game. They live here now so
 * an operator can retune a threshold, rename a badge or retire one without a
 * deploy — the console writes these rows and the award pass reads them.
 *
 * The CONDITIONS are stored as data, never as code: a rule is a metric, a
 * comparator and a threshold (see packages/game/src/badgeRules.ts). Storing an
 * expression an admin could edit would mean executing admin-authored code on
 * the server, which is not a trade worth making for a badge.
 *
 * Seeded from DEFAULT_BADGE_RULES on first run. Once seeded these rows are the
 * authority: a later release changing the defaults must not silently revert an
 * operator's tuning.
 */
model BadgeRule {
  id       String @id @default(cuid())
  /** Stable identifier. Matches UserBadge.badgeKey, so renaming the LABEL is
      free but changing the key would orphan every award — the API refuses it. */
  key      String @unique
  label    String
  description String
  category String
  rarity   String
  /** Which animal crest to draw, from the art table in the web app. */
  artKey   String
  glyph    String

  /**
   * The conditions, as a JSON array of { metric, comparator, threshold }.
   * ANDed together. Validated against the closed metric list on write, so a
   * malformed rule cannot reach the evaluator.
   */
  conditions Json

  /** Index of the condition that drives the progress bar; null for none. */
  progressFrom Int?
  /**
   * For a REPEATABLE badge: how much of the progress metric earns one more
   * copy, drawn as the "x2" bubble. Null for an ordinary once-only badge.
   */
  repeatEvery  Int?
  /** A disabled rule stays in the table but is never awarded or shown. */
  enabled      Boolean @default(true)
  sortOrder    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, sortOrder])
}

/**
 * One row per rating change, per player.
 *
 * This is the audit trail. It answers "why is my rating this number?" with a
 * specific battle and opponent rather than a shrug, and it is what the rating
 * graph on a profile is drawn from. Rows are never updated.
 */
model RatingHistory {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  battleId String

  ratingBefore Float
  ratingAfter  Float
  rdBefore     Float
  rdAfter      Float
  /** ratingAfter - ratingBefore, stored so a graph needs no window function. */
  delta        Float
  /** The opponent's rating at the time. Null for a multi-opponent battle. */
  opponentRating Float?
  /** 1 win, 0 loss, 0.5 draw. */
  score        Float
  seasonId     String?
  createdAt    DateTime @default(now())

  @@unique([userId, battleId])
  @@index([userId, createdAt])
  @@index([battleId])
}

/**
 * A competitive season.
 *
 * Without seasons the ladder is won permanently by whoever joined first, and a
 * player arriving in month six can see no route to the top. At each boundary
 * ratings are pulled toward the origin (softReset in packages/game), so the
 * ordering survives but the spread compresses and the top is reachable again.
 *
 * Exactly one row may have `isActive`, enforced by the partial unique index
 * below.
 */
model Season {
  id        String    @id @default(cuid())
  name      String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  isActive  Boolean   @default(false)

  standings SeasonStanding[]

  @@index([isActive])
}

/**
 * A player's final standing in a closed season.
 *
 * Written once when a season ends, then immutable. This is what makes a soft
 * reset acceptable: nobody's record is erased, it is archived, and a profile
 * can show "Season 1: Beta, #14" forever.
 */
model SeasonStanding {
  id       String @id @default(cuid())
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  rank          Int
  rating        Float
  rd            Float
  /** The tier held at close, e.g. "ALPHA". Denormalised so the archive still
      reads correctly if the tier thresholds are ever retuned. */
  tier          String
  wins          Int
  losses        Int
  rankedBattles Int
  xpEarned      Int   @default(0)

  @@unique([seasonId, userId])
  @@index([seasonId, rank])
  @@index([userId])
}

/**
 * A player waiting in the ranked queue.
 *
 * Ranked battles exist so that rating cannot be farmed. In a room-code battle
 * you choose your opponent, so two accounts can trade wins; here the SERVER
 * chooses, which is what makes the number mean anything.
 *
 * One row per user (userId is unique), so a double-click cannot enqueue twice.
 */
model MatchQueueEntry {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /** Snapshot of the rating at enqueue, so pairing needs no join. */
  rating     Float
  difficulty Difficulty
  mode       Mode     @default(ONE_V_ONE)
  enqueuedAt DateTime @default(now())

  @@index([mode, difficulty, rating])
  @@index([enqueuedAt])
}

model Problem {
  id                 String     @id @default(cuid())
  title              String
  statementMarkdown  String
  constraints        String
  difficulty         Difficulty
  allowedLanguages   String[]
  // language -> starter snippet, e.g. { "PYTHON": "def solve(): ..." }
  starterCode        Json
  timeLimitDefaultSec Int       @default(600)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt @default(now())

  /**
   * Review state. APPROVED by default so admin-authored problems (and every
   * problem seeded before community submissions existed) are immediately
   * usable. Battle selection filters on this — see ws-server battleRoom.
   */
  status       ProblemStatus @default(APPROVED)

  /** Who submitted it. Null for seeded and admin-authored problems. */
  authorId     String?
  author       User?         @relation("AuthoredProblems", fields: [authorId], references: [id], onDelete: SetNull)

  /** Why it was rejected, shown to the author so they can fix and resubmit. */
  reviewNote   String?
  reviewedAt   DateTime?
  /** The admin who approved or rejected it. */
  reviewedById String?

  testCases TestCase[]
  battles   Battle[]
  /** League fixture legs that pinned this problem. */
  leagueLegs LeagueFixtureLeg[] @relation("LeagueLegProblem")

  @@index([difficulty])
  // Battle selection filters on both, in this order.
  @@index([status, difficulty])
  @@index([authorId, status])
}

model TestCase {
  id             String   @id @default(cuid())
  problemId      String
  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  kind           TestKind
  input          String
  expectedOutput String
  ordinal        Int
  weight         Int      @default(1)

  @@index([problemId, kind])
}

model Battle {
  id                String        @id @default(cuid())
  roomCode          String        @unique
  mode              Mode
  difficulty        Difficulty
  timeLimitSec      Int
  status            BattleStatus  @default(LOBBY)
  seed              String
  hostUserId        String
  host              User          @relation("HostedBattles", fields: [hostUserId], references: [id])
  assignedProblemId String?
  problem           Problem?      @relation(fields: [assignedProblemId], references: [id])
  serverStartAt     DateTime?
  serverEndAt       DateTime?
  winnerSide        Side?
  finishReason      FinishReason?
  createdAt         DateTime      @default(now())

  /**
   * Whether this battle moves ratings.
   *
   * False for room-code battles, which is the whole anti-farming design: you
   * pick your own opponent there, so any rating movement would be trivially
   * traded between two accounts. Only battles the matchmaker paired are
   * ranked. Set at creation and never changed — a battle cannot become ranked
   * after the players have seen who they are up against.
   */
  isRanked          Boolean       @default(false)

  /** The season this battle counted toward, for archived standings. */
  seasonId          String?

  teams       Team[]
  submissions Submission[]
  result      Result?
  /** Set when this battle is a leg of a league fixture rather than a duel. */
  leagueLeg   LeagueFixtureLeg? @relation("LeagueLegBattle")

  @@index([status])
  @@index([isRanked, status])
}

model Team {
  id       String @id @default(cuid())
  battleId String
  battle   Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  side     Side

  members TeamMember[]

  @@unique([battleId, side])
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  slot     Int
  joinedAt DateTime @default(now())

  @@unique([teamId, slot])
}

model Submission {
  id             String           @id @default(cuid())
  battleId       String
  battle         Battle           @relation(fields: [battleId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  teamSide       Side
  language       String
  sourceCode     String
  status         SubmissionStatus @default(QUEUED)
  passedCount    Int              @default(0)
  totalCount     Int              @default(0)
  perTestResults Json?
  runtimeMs      Int              @default(0)
  errorMessage   String?
  // Server-received time — the sole tie-break authority.
  submittedAt    DateTime         @default(now())
  judgedAt       DateTime?

  @@index([battleId, submittedAt])
}

model Result {
  id                   String       @id @default(cuid())
  battleId             String       @unique
  battle               Battle       @relation(fields: [battleId], references: [id], onDelete: Cascade)
  winnerSide           Side?
  reason               FinishReason
  decidingSubmissionId String?
  standings            Json
  createdAt            DateTime     @default(now())
}

/**
 * One row per page load, written by the web app's /api/track route.
 *
 * `visitorId` is a random id in a first-party cookie — it identifies a browser
 * for unique-visitor counts and nothing else. No IP address, no user agent,
 * no cross-site identifier is stored, so this stays a hit counter rather than
 * becoming a tracking profile.
 */
model PageView {
  id        String   @id @default(cuid())
  path      String
  /** Anonymous per-browser id from a first-party cookie. */
  visitorId String
  /** Set when the visitor happened to be signed in; null otherwise. */
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId])
  @@index([path])
}

// =============================================================================
// Leagues
// =============================================================================
//
// A league is a player-run tournament: someone creates one, people join and
// form teams, and the host pairs those teams into matches that are played on
// the ordinary battle engine.
//
// WHY LEAGUE TEAMS ARE NOT `Team`
// -------------------------------
// `Team` is a seat allocation inside ONE battle — it is created with the
// battle, holds a Side, and dies with it. A league team is a standing roster
// that exists before any match and outlives every one it plays. Overloading
// `Team` would mean a roster with a meaningless `side` and a mandatory
// `battleId` pointing at nothing. They are different nouns, so they are
// different tables; a fixture is what maps one onto the other.

/**
 * Who may join a league.
 *
 * PUBLIC leagues are listed and anyone may form a team. PRIVATE leagues are
 * unlisted and reachable only with the join code. The code exists for both —
 * it is the shareable handle — but only a PRIVATE league depends on it for
 * access.
 */
enum LeagueVisibility {
  PUBLIC
  PRIVATE
}

/**
 * A league's lifecycle.
 *
 * DRAFT    — being set up; not yet accepting teams.
 * OPEN     — accepting teams. Matches may already be scheduled.
 * RUNNING  — registration closed by the host; matches continue.
 * FINISHED — the host has called it; the standings are final.
 * CANCELLED— called off before it could finish.
 *
 * The host moves it along by hand rather than the system inferring it: a
 * league can legitimately sit half-played for a week, and guessing "this
 * looks finished" would close leagues out from under people.
 *
 * CANCELLED is deliberately distinct from FINISHED and from deletion. A
 * league that was abandoned did not produce a champion, so recording it as
 * finished would put a winner on something nobody won; deleting it would
 * erase matches people actually played. It stops accepting teams and matches
 * while staying readable.
 *
 * The declaration ORDER is load-bearing: the browse list sorts by status, so
 * the states people can still act on come before the archived ones.
 */
enum LeagueStatus {
  DRAFT
  OPEN
  RUNNING
  FINISHED
  CANCELLED
}

/**
 * How a league decides which teams advance out of a round.
 *
 * TOP_N     — the best N in the table go through. The usual format.
 * WIN_COUNT — everyone with at least N wins goes through, however many that
 *             turns out to be. Can qualify five teams, or none.
 */
enum QualificationMode {
  TOP_N
  WIN_COUNT
}

/**
 * The stage a fixture belongs to.
 *
 * Present from the start even though stage 1 only schedules GROUP matches, so
 * that adding the bracket later is new rows rather than a migration of every
 * existing fixture.
 */
enum LeagueRound {
  GROUP
  /**
   * A play-off between teams that finished level at the qualification line.
   *
   * Its own round for a reason: a decider must NOT be counted in the group
   * table it exists to resolve. Filing it as GROUP would change the very
   * points and leg difference that made the teams level, so the table would
   * shift underneath the decider as soon as it was played — and could even
   * separate the teams the other way, contradicting its own result.
   */
  TIEBREAK
  QUARTER_FINAL
  SEMI_FINAL
  FINAL
}

/** How far a fixture has got. */
enum FixtureStatus {
  /** Created by the host; no leg has been played. */
  SCHEDULED
  /** At least one leg played, the tie not yet decided. */
  LIVE
  /** Decided — `winnerTeamId` is set (or it was a draw). */
  COMPLETED
  /** The host called it off. */
  CANCELLED
}

model League {
  id          String           @id @default(cuid())
  name        String
  description String           @default("")

  /**
   * The league's logo, stored the same way a profile photo is: a downscaled
   * square JPEG as a data URL. See apps/web/lib/image.ts for why there is no
   * object store yet, and why this column takes a real URL unchanged the day
   * one arrives.
   */
  logoUrl     String?

  /** Shareable handle. Unique, unambiguous alphabet, same generator as rooms. */
  joinCode    String           @unique

  visibility  LeagueVisibility @default(PUBLIC)
  status      LeagueStatus     @default(OPEN)

  /**
   * How many players make up one team, 1-4.
   *
   * Fixed at creation and never edited: teams are formed against this number,
   * so lowering it later would leave existing rosters over-sized and raising
   * it would silently make already-full teams incomplete.
   *
   * It also decides the battle Mode a fixture runs at — teamSize 2 plays as
   * TWO_V_TWO — which is why the range matches MODE_TEAM_SIZE exactly.
   */
  teamSize    Int              @default(1)

  /** Cap on registered teams. Null means no cap. */
  maxTeams    Int?

  /**
   * How teams advance out of the group stage.
   *
   * Nullable because a league does not have to be a knockout — plenty will
   * just be a table of matches with no bracket at all, and forcing a rule on
   * those would mean inventing one they never asked for. The host sets it
   * when (and if) they decide to run a knockout.
   */
  qualifyMode  QualificationMode?
  /** Places for TOP_N; required wins for WIN_COUNT. */
  qualifyValue Int?

  hostUserId  String
  host        User             @relation("HostedLeagues", fields: [hostUserId], references: [id], onDelete: Cascade)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  /** Set when the host finishes the league; the standings freeze here. */
  finishedAt  DateTime?

  teams    LeagueTeam[]
  fixtures LeagueFixture[]

  // The public listing filters on both and orders by recency.
  @@index([visibility, status])
  @@index([hostUserId])
}

/**
 * A standing roster inside one league.
 *
 * `name` is unique per league so a scoreboard reading "Team Rocket vs Team
 * Rocket" is impossible.
 */
model LeagueTeam {
  id       String @id @default(cuid())
  leagueId String
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  name     String
  /** Optional team crest, stored like the league logo. */
  logoUrl  String?

  /** Whoever created the team. They may rename it and remove members. */
  captainUserId String

  createdAt DateTime @default(now())

  members      LeagueTeamMember[]
  homeFixtures LeagueFixture[]    @relation("HomeTeam")
  awayFixtures LeagueFixture[]    @relation("AwayTeam")
  wonFixtures  LeagueFixture[]    @relation("FixtureWinner")

  @@unique([leagueId, name])
  @@index([leagueId])
}

model LeagueTeamMember {
  id     String     @id @default(cuid())
  teamId String
  team   LeagueTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  // One row per player per team...
  @@unique([teamId, userId])
  // ...and this index is what makes "is this player already in a team in this
  // league?" a cheap query. The league-wide uniqueness itself cannot be a
  // constraint here because leagueId lives on the parent, so the service
  // enforces it — see leagues.service joinTeam.
  @@index([userId])
}

/**
 * One scheduled tie between two teams.
 *
 * WHY A FIXTURE IS NOT A BATTLE
 * -----------------------------
 * The host may set several problems for a tie, and it plays as a series: one
 * battle per problem, and the team that wins the most legs wins the tie. So a
 * fixture is the tie, and `legs` are the battles that decide it. A single
 * -problem fixture is simply a series of one.
 */
model LeagueFixture {
  id       String @id @default(cuid())
  leagueId String
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  round    LeagueRound   @default(GROUP)
  status   FixtureStatus @default(SCHEDULED)

  homeTeamId String
  homeTeam   LeagueTeam @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeamId String
  awayTeam   LeagueTeam @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)

  /**
   * Per-leg clock, in seconds. Set by the host; falls back to the problem's
   * own default when they do not care.
   */
  timeLimitSec Int @default(1800)

  /**
   * Difficulty for legs the host left to chance.
   *
   * Only consulted for a leg with no problem set. A fully-specified fixture
   * never reads it.
   */
  difficulty Difficulty @default(MEDIUM)

  /** Set once the tie is decided. Null while SCHEDULED or LIVE, or on a draw. */
  winnerTeamId String?
  winnerTeam   LeagueTeam? @relation("FixtureWinner", fields: [winnerTeamId], references: [id], onDelete: SetNull)

  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  legs LeagueFixtureLeg[]

  @@index([leagueId, round])
  @@index([leagueId, status])
}

/**
 * One problem within a fixture — a single battle.
 *
 * `problemId` is nullable and that is the "let the system choose" case: the
 * leg is created without one and the battle engine picks at kick-off, under
 * the same repeat-cooldown rules an ordinary battle uses. A host who picked a
 * problem gets exactly that problem.
 *
 * `battleId` is null until the leg is actually started, which is what makes a
 * fixture schedulable in advance without holding open an empty battle room.
 */
model LeagueFixtureLeg {
  id        String        @id @default(cuid())
  fixtureId String
  fixture   LeagueFixture @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  /** 1-based position in the series, so leg 2 is always leg 2. */
  ordinal   Int

  /** The host's chosen problem, or null to let the engine pick. */
  problemId String?
  problem   Problem? @relation("LeagueLegProblem", fields: [problemId], references: [id], onDelete: SetNull)

  /** The battle that played this leg. Null until kick-off. */
  battleId  String?  @unique
  battle    Battle?  @relation("LeagueLegBattle", fields: [battleId], references: [id], onDelete: SetNull)

  /** Which team won this leg. Null while unplayed or on a draw. */
  winnerTeamId String?

  createdAt DateTime @default(now())

  @@unique([fixtureId, ordinal])
  @@index([fixtureId])
}

/**
 * What a notification is telling someone.
 *
 * Deliberately a closed enum rather than free text: the client renders each
 * kind with its own icon, wording and destination, so an unknown kind would
 * arrive as an unstyled row nobody knows what to do with. Adding a kind is a
 * deliberate act that updates both ends.
 */
enum NotificationKind {
  /** A fixture involving your team was scheduled. */
  LEAGUE_FIXTURE_SCHEDULED
  /** A leg of your fixture has kicked off — the room is open now. */
  LEAGUE_MATCH_STARTED
  /** A tie you were in has been decided. */
  LEAGUE_FIXTURE_RESULT
  /** Your team is in a decider for a qualification place. */
  LEAGUE_TIEBREAK_SCHEDULED
  /** A knockout round was drawn and your team is in it. */
  LEAGUE_ROUND_DRAWN
  /** The league finished and there is a champion. */
  LEAGUE_FINISHED
}

/**
 * One thing a user should know about.
 *
 * WHY THIS IS A TABLE AND NOT A PUSH
 * ----------------------------------
 * A live socket only reaches someone who happens to have the page open. A
 * league runs over days, and the whole point of telling someone their match
 * was scheduled is that they are NOT currently looking. So the notification
 * is durable first and pushed second: the row is the truth, and a live socket
 * is an optimisation on top of it.
 *
 * `link` is stored rather than derived so a notification keeps working even
 * if the thing it points at is later restructured — and so the client needs
 * no switch over kinds just to know where to go.
 */
model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   NotificationKind

  /** One line, already written for a human. */
  title String
  /** Optional second line with the detail. */
  body  String?
  /** Where clicking it goes, e.g. "/leagues/abc123". */
  link  String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  // The unread badge and the list both filter on user and sort by recency.
  @@index([userId, readAt])
  @@index([userId, createdAt])
}
